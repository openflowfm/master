{
  "name": "@openflow/master",
  "version": "0.1.0",
  "private": true,
  "author": "Ryan Gavin",
  "license": "MIT",
  "type": "module",
  "description": "master[flow]: improves an iPhone recording inside Ableton Live, through the bridge — listens with the probes, plans a chain of Live's own devices, sets it in real units and checks the result.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openflowfm/master.git"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "master-flow": "dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@openflow/protocol": "github:openflowfm/protocol#952a16df6fc2e9b94ab2a417e9bd5837853d9707"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.0",
    "ws": "^8.22.0"
  }
}
